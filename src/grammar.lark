campaign: test+

test: NAME_K WORD NL PROGRAMS_K "[" programs "]" NL DATA_PROTECTION_K DATA_PROTECTION NL CONTROL_FLOW_K CONTROL_FLOW NL timeout? execution_repetitions? compiler_flags? injection? functions?

timeout: TIMEOUT_K POSITIVE_INT NL
execution_repetitions: EXECUTION_REPETITIONS_K POSITIVE_INT NL
compiler_flags: COMPILER_FLAGS_K "[" compiler_flag_list? "]" NL

injection: INJECTION_K injection_mode NL
?injection_mode: register_mode | memory_mode | global_mode
register_mode: "register" (DATA_ONLY_K BOOLEAN)?
memory_mode: "memory"
global_mode: "global"

functions: FUNCTIONS_K "[" function_list? "]" NL
function_list: function_def ("," function_def)*
function_def: WORD ("(" var_list ")")?
var_list: var_def ("," var_def)*
var_def: GLOBAL_MARKER? WORD (":" POSITIVE_INT)?

programs: program ("," program)*
program: PROGRAM_PATH | ESCAPED_STRING

compiler_flag_list: COMPILER_FLAG ("," COMPILER_FLAG)*

NAME_K:				"name:"
PROGRAMS_K:			"programs:"
DATA_PROTECTION_K:	"data_protection:"
CONTROL_FLOW_K:		"control_flow_protection:"
TIMEOUT_K:			"timeout_ms:"
EXECUTION_REPETITIONS_K: "execution_repetitions:"
COMPILER_FLAGS_K:	"compiler_flags:"
INJECTION_K:		"injection:"
FUNCTIONS_K:		"functions:"
DATA_ONLY_K:		"data_only:"
TARGET_GLOBAL_K:	"target_global:"
GLOBAL_MARKER:		"@"
BOOLEAN:			"true" | "false"

DATA_PROTECTION: "eddi" | "seddi" | "fdsc" | "none"
CONTROL_FLOW:	 "cfcss" | "rasm" | "inter-rasm" | "none"
PROGRAM_PATH: /[^\s,\[\]"]+\.(?:cpp|c|rs)/
POSITIVE_INT: /[1-9][0-9]*/
COMPILER_FLAG: /[^\s,\[\]]+/

WORD: /[A-Za-z0-9_-]+/
NL: /\r?\n/

%ignore /[ \t]+/
%ignore /\r?\n[ \t]*(?=\r?\n)/
%import common.ESCAPED_STRING
